<Window x:Class="ProjectAppOrganizer.App.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attach a window" Height="480" Width="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource SansFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource BaseBrush}">
    <Window.Resources>
        <Style x:Key="PickerItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <DockPanel>
                                <Ellipse Width="6" Height="6" DockPanel.Dock="Left" Margin="0,0,11,0"
                                         VerticalAlignment="Center" Fill="{StaticResource CyanBrush}"/>
                                <TextBlock Text="{Binding ProcessName}" DockPanel.Dock="Right"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#141A26"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="2,0,0,12">
            <TextBlock Text="ATTACH WINDOW" Style="{StaticResource SectionLabel}" FontSize="12"/>
            <TextBlock Text="Pick an open window to dock into this project"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                    Height="34" Width="92"/>
            <Button Content="Attach" Click="Ok_Click" Style="{StaticResource AccentButton}"
                    Height="34" Width="100" Margin="10,0,0,0"/>
        </StackPanel>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource StrokeSubtleBrush}"
                BorderThickness="1" CornerRadius="9" Padding="6">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource PickerItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Ok_Click"/>
        </Border>
    </DockPanel>
</Window>
