<Window x:Class="ProjectAppOrganizer.App.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource SansFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource BaseBrush}">
    <DockPanel Margin="22,20,22,20">
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontFamily="{StaticResource MonoFont}"
                   FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" LineHeight="19"/>
        <StackPanel x:Name="ButtonHost" DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </DockPanel>
</Window>
