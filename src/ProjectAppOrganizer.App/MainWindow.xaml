<Window x:Class="ProjectAppOrganizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project App Organizer" Height="820" Width="1320"
        WindowState="Maximized"
        FontFamily="{StaticResource SansFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        Background="{StaticResource BaseBrush}">

    <Window.Resources>
        <!-- Shared multi-line todo row (used by both the active and completed lists) -->
        <DataTemplate x:Key="TodoTemplate">
            <Border x:Name="todoRow" Background="Transparent" Padding="8,5" Margin="0,1">
                <DockPanel>
                    <CheckBox IsChecked="{Binding Done}" Style="{StaticResource TodoCheck}"
                              DockPanel.Dock="Left" Margin="0,2,11,0" VerticalAlignment="Top"/>
                    <Button x:Name="todoDel" DockPanel.Dock="Right" Click="DeleteTodo_Click"
                            Tag="{Binding}" Style="{StaticResource TabCloseButton}"
                            Visibility="Hidden" VerticalAlignment="Top" ToolTip="Delete task"/>
                    <TextBox x:Name="todoText" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TodoTextBox}" PreviewKeyDown="Todo_PreviewKeyDown"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="todoRow" Property="IsMouseOver" Value="True">
                    <Setter TargetName="todoDel" Property="Visibility" Value="Visible"/>
                </Trigger>
                <DataTrigger Binding="{Binding Done}" Value="True">
                    <Setter TargetName="todoText" Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                    <Setter TargetName="todoText" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Visibility helpers driven by whether a project (the DataContext) is selected -->
        <Style x:Key="HideWhenNoProject" TargetType="Panel">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShowWhenNoProject" TargetType="Panel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.28"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204" MinWidth="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="288" MinWidth="210"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Project rail ===================== -->
        <Border Grid.Column="0" Background="{StaticResource RailBrush}"
                BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7,0 L 14,7 L 7,14 L 0,7 Z" Fill="{StaticResource AccentBrush}"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                              Effect="{StaticResource AccentGlow}"/>
                        <TextBlock Text="ORGANIZER" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                   FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource StrokeSubtleBrush}" Margin="0,14,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="PROJECTS" Style="{StaticResource SectionLabel}"
                           Margin="20,4,0,8"/>

                <Button DockPanel.Dock="Bottom" Content="+  New Project" Click="AddProject_Click"
                        Style="{StaticResource AccentButton}" Margin="14,10,14,16" Height="36"/>

                <ListBox x:Name="ProjectList" Style="{StaticResource ProjectListBox}"
                         ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button x:Name="projDel" DockPanel.Dock="Right" Click="DeleteProject_Click"
                                        Tag="{Binding}" Style="{StaticResource TabCloseButton}"
                                        Visibility="Hidden" ToolTip="Delete project"/>
                                <Border x:Name="pdot" Width="7" Height="7" CornerRadius="4"
                                        Background="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                        Margin="0,0,11,0"/>
                                <TextBlock Text="{Binding Project.Name}" FontFamily="{StaticResource MonoFont}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True"
                                             Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <Setter TargetName="projDel" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Value="True"
                                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <Setter TargetName="projDel" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="pdot" Property="Background" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"/>

        <!-- ===================== Detail panel ===================== -->
        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" DataContext="{Binding SelectedProject}">
            <Grid>
                <DockPanel Style="{StaticResource HideWhenNoProject}" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Margin="18,12,18,0">
                        <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TitleBox}"/>
                        <TextBox Text="{Binding Project.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BodyBox}" MinHeight="64" MaxHeight="200"
                                 VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>

                        <TextBlock Text="WORKING FOLDER" Style="{StaticResource SectionLabel}" Margin="2,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="FolderBox"
                                         Text="{Binding Project.FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PathBox}" Height="34"/>
                                <TextBlock Text="Not set — click Browse" IsHitTestVisible="False"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FolderBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="1" Content="Browse" Click="Browse_Click"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="34"/>
                        </Grid>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Content="+  Add task" Click="AddTodo_Click"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                            Margin="18,8,18,18"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,18,6,0">
                        <StackPanel>
                            <Grid Margin="8,0,8,6">
                                <TextBlock Text="TODO" Style="{StaticResource SectionLabel}"/>
                                <Border HorizontalAlignment="Right" Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="9" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveTodos.Count}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                </Border>
                            </Grid>
                            <ItemsControl x:Name="TodoList" ItemsSource="{Binding ActiveTodos}"
                                          ItemTemplate="{StaticResource TodoTemplate}"/>

                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CompletedTodos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Grid Margin="8,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="COMPLETED" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding CompletedTodos.Count}" FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Content="Clear completed"
                                            Click="DeleteAllCompleted_Click" Style="{StaticResource GhostButton}"
                                            Padding="8,3" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="CompletedList" ItemsSource="{Binding CompletedTodos}"
                                              ItemTemplate="{StaticResource TodoTemplate}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel Style="{StaticResource ShowWhenNoProject}" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Opacity="0.6">
                    <TextBlock Text="NO PROJECT" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select or create a project on the left"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="3"/>

        <!-- ===================== Main : tabs + stage ===================== -->
        <Grid Grid.Column="4" DataContext="{Binding SelectedProject}">
            <DockPanel Style="{StaticResource HideWhenNoProject}">
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="0,0,0,1">
                    <DockPanel Margin="10,8,12,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="10,0,0,8">
                            <Button Content="+  Terminal" Click="OpenTerminal_Click"
                                    Style="{StaticResource AccentButton}" Height="32">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="PowerShell" Tag="PowerShell" Click="LaunchShell_Click"/>
                                        <MenuItem Header="Command Prompt" Tag="Cmd" Click="LaunchShell_Click"/>
                                        <MenuItem Header="Git Bash" Tag="GitBash" Click="LaunchShell_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Attach Window" Click="AttachWindow_Click"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" Height="32"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TabChip}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="11,0,8,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource CyanBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTerminal}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Button Content="{Binding Title}" Click="ActivateTab_Click"
                                                    Tag="{Binding}" Style="{StaticResource TabLabelButton}"/>
                                            <Button Click="CloseTab_Click" Tag="{Binding}"
                                                    Style="{StaticResource TabCloseButton}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border x:Name="Stage" Margin="14" CornerRadius="10"
                        BorderBrush="{StaticResource StrokeSubtleBrush}" BorderThickness="1"
                        Background="#0A0D14">
                    <Grid>
                        <Rectangle RadiusX="10" RadiusY="10" Fill="{StaticResource DotGridBrush}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7">
                            <Border Width="62" Height="46" CornerRadius="6" HorizontalAlignment="Center"
                                    BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1.5">
                                <Border Height="11" VerticalAlignment="Top" Background="{StaticResource StrokeStrongBrush}"
                                        CornerRadius="5,5,0,0"/>
                            </Border>
                            <TextBlock Text="NO WINDOW STAGED" FontFamily="{StaticResource MonoFont}"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock Text="Open a terminal or attach a window to begin"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <StackPanel Style="{StaticResource ShowWhenNoProject}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Opacity="0.5">
                <Border Width="64" Height="48" CornerRadius="6" HorizontalAlignment="Center"
                        BorderBrush="{StaticResource StrokeStrongBrush}" BorderThickness="1.5">
                    <Border Height="11" VerticalAlignment="Top" Background="{StaticResource StrokeStrongBrush}"
                            CornerRadius="5,5,0,0"/>
                </Border>
                <TextBlock Text="NO PROJECT SELECTED" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                <TextBlock Text="Create or choose a project to dock windows into"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
