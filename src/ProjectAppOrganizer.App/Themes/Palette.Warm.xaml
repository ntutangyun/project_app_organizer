<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         WARM PALETTE  ·  warm paper + dark grey ink + burnt amber
         Paper tones follow sle_debugger's light theme; the amber accent
         is darkened so it stays readable on a light surface.
         Every key here must also exist in Palette.Dark.xaml.
         ============================================================ -->

    <SolidColorBrush x:Key="InkBrush" Color="#EBE8E0"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#F5F3EE"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#E4E0D6"/>
    <SolidColorBrush x:Key="ElevatedHoverBrush" Color="#DDD8CC"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#ECE9E1"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FDFCFA"/>
    <SolidColorBrush x:Key="GhostFillBrush" Color="#80FDFCFA"/>
    <SolidColorBrush x:Key="StageBrush" Color="#E5E1D8"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9C4B8"/>
    <SolidColorBrush x:Key="StrokeSubtleBrush" Color="#D8D3C8"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#C2BCAF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2B2D31"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5B606C"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#717684"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#9C5708"/>
    <SolidColorBrush x:Key="AccentColorDeepBrush" Color="#C08E45"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F0E2C4"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFAF0"/>
    <SolidColorBrush x:Key="DoneBrush" Color="#1A7A50"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C23B4B"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F3D9D9"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#1F7A99"/>

    <!-- Filled accent button (its label is drawn in the primary text colour, so keep this light) -->
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDB45C" Offset="0"/>
        <GradientStop Color="#DE9A38" Offset="1"/>
    </LinearGradientBrush>

    <!-- Rail / base gradients -->
    <LinearGradientBrush x:Key="RailBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F1EEE7" Offset="0"/>
        <GradientStop Color="#EDEAE2" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EBE8E0" Offset="0"/>
        <GradientStop Color="#E7E3DA" Offset="1"/>
    </LinearGradientBrush>

    <!-- Faint dotted grid for the stage -->
    <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Viewport="0,0,22,22"
                  ViewportUnits="Absolute" Opacity="0.7">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#DCD7CC">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Soft amber glow used on active elements -->
    <DropShadowEffect x:Key="AccentGlow" Color="#B56B12" BlurRadius="12"
                      ShadowDepth="0" Opacity="0.30"/>
    <DropShadowEffect x:Key="PanelShadow" Color="#28241E" BlurRadius="18"
                      ShadowDepth="0" Opacity="0.22"/>

</ResourceDictionary>
